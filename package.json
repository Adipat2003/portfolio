{
  "name": "aditya-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-local-secrets.mjs dev:local",
    "dev:local": "next dev",
    "build": "node scripts/with-local-secrets.mjs build:local",
    "build:local": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/with-local-secrets.mjs start:local",
    "start:local": "next start",
    "typecheck": "tsc --noEmit",
    "build:service": "tsc -p server/tsconfig.json",
    "start:service": "node scripts/with-local-secrets.mjs start:service:local",
    "start:service:local": "node server/dist/server/index.js",
    "check:service": "npm run build:service && node scripts/service-check.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.0"
  }
}
