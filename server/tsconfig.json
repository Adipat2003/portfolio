{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": false,
		"declaration": false,
		"incremental": false,
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "..",
		"types": ["node"]
	},
	"include": ["**/*.ts", "../src/content/**/*.ts"],
	"exclude": ["dist", "../src/content/load.ts", "../src/content/mosaics.ts", "../src/content/bites.ts"]
}
